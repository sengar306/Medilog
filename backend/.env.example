# MediLog Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Server
PORT=5000

# MongoDB Atlas (required)
# Replace <db_password> with the password for user: viveksengar921927_db_user
MONGO_URI=mongodb+srv://viveksengar921927_db_user:<db_password>@cluster0.upubo2u.mongodb.net/medilog?retryWrites=true&w=majority&appName=Cluster0

# Auth — use a strong random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=1232103623323969
WHATSAPP_BUSINESS_ACCOUNT_ID=2279329115805173

# Facebook App OAuth (for WhatsApp connect button)
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_REDIRECT_URI=https://your-render-service.onrender.com/api/v1/whatsapp/auth/facebook/callback
